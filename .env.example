# Supabase Configuration
# Copy this file to '.env' and fill in your Supabase project credentials.

# The API URL of your Supabase project (found in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# The Anon / Public API Key of your Supabase project (found in Project Settings > API)
SUPABASE_KEY=your-anon-public-key
